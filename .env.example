# Neon, branch `production` (the project's only branch).
# Neon console → Connect → copy both strings (Neon's names).

# Direct connection: used by drizzle-kit for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/paddock_pass?sslmode=require"

# Pooled connection (host contains "-pooler"): used by the app.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/paddock_pass?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32-random-bytes-in-base64"
# Base URL of the app: http://localhost:3000 locally, the public URL on Vercel.
BETTER_AUTH_URL="http://localhost:3000"
